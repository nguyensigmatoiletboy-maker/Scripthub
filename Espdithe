local function findRootUnit(abnormality)
    local targetName = normalizeName(abnormality.Name)

    local exact = Units:FindFirstChild(abnormality.Name)

    if exact then
        return exact
    end

    for _, unit in ipairs(Units:GetChildren()) do
        if unit:IsA("Model") or unit:IsA("BasePart") then
            if normalizeName(unit.Name) == targetName then
                return unit
            end
        end
    end

    return nil
end

local function findMinionUnits(minionName)
    local result = {}
    local normalized = normalizeName(minionName)

    for _, unit in ipairs(Units:GetChildren()) do
        if unit:IsA("Model") or unit:IsA("BasePart") then
            if normalizeName(unit.Name) == normalized then
                table.insert(result, unit)
            end
        end
    end

    return result
end

local function removeRootESP(abnormality)
    for unit, data in pairs(ESPData) do
        if data.Abnormality == abnormality then
            removeESP(unit)
        end
    end
end

local function checkAbnormality(abnormality)
    if not ESPEnabled then
        return
    end

    if not abnormality or not abnormality.Parent then
        return
    end

    local isBreached = abnormality:FindFirstChild("IsBreached")

    if not isBreached then
        return
    end

    if isBreached.Value ~= true then
        removeRootESP(abnormality)
        return
    end

    local root = findRootUnit(abnormality)

    if root then
        createESP(root, abnormality.Name, true)

        if ESPData[root] then
            ESPData[root].Abnormality = abnormality
        end
    end

    local minionList = Minions[abnormality.Name]

    if minionList then
        for _, minionName in ipairs(minionList) do
            for _, minion in ipairs(findMinionUnits(minionName)) do
                createESP(minion, minion.Name, false)

                if ESPData[minion] then
                    ESPData[minion].Abnormality = abnormality
                end
            end
        end
    end
end

local function checkSpecialUnits()
    if not ESPEnabled then
        return
    end

    for name in pairs(SpecialUnits) do
        local unit = Units:FindFirstChild(name)

        if unit then
            createESP(unit, name, true)
        end
    end
end

local function checkAll()
    if not ESPEnabled then
        return
    end

    if PendingCheck then
        return
    end

    PendingCheck = true

    task.delay(0.15, function()
        PendingCheck = false

        if not ESPEnabled then
            return
        end

        for _, abnormality in ipairs(Abnormalities:GetChildren()) do
            checkAbnormality(abnormality)
        end

        checkSpecialUnits()
    end)
end

local function setupAbnormality(abnormality)
    local isBreached = abnormality:FindFirstChild("IsBreached")

    if isBreached and isBreached:IsA("BoolValue") then
        isBreached:GetPropertyChangedSignal("Value"):Connect(function()
            checkAbnormality(abnormality)
        end)
    end

    checkAbnormality(abnormality)
end

for _, abnormality in ipairs(Abnormalities:GetChildren()) do
    setupAbnormality(abnormality)
end

