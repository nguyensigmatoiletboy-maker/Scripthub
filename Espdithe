local SelectedWork = nil
local SelectedAbnormalities = {}
local SelectedSpeed = "Bình thường"
local AutoWorkEnabled = false

local SpeedTimes = {
    ["Siêu chậm"] = 10,
    ["Chậm"] = 8,
    ["Bình thường"] = 5.5,
    ["Nhanh"] = 3
}

local AbnormalitiesFolder = workspace:WaitForChild("Abnormalities")

local function GetAbnormalityList()
    local List = {}

    for _, child in ipairs(AbnormalitiesFolder:GetChildren()) do
        table.insert(List, child.Name)
    end

    table.sort(List)

    if #List == 0 then
        table.insert(List, "Không tìm thấy")
    end

    return List
end

local AbnormalityDropdown = Tab:Dropdown({
    Title = "1. Chọn Abnormality",
    Desc = "Có thể chọn nhiều Abnormality",
    Values = GetAbnormalityList(),
    Multi = true,

    Callback = function(Values)
        SelectedAbnormalities = {}

        if type(Values) == "table" then
            for _, Value in ipairs(Values) do
                if Value ~= "Không tìm thấy" then
                    table.insert(SelectedAbnormalities, Value)
                end
            end
        elseif Values and Values ~= "Không tìm thấy" then
            table.insert(SelectedAbnormalities, Values)
        end
    end
})

