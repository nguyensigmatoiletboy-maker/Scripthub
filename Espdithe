        Root = isRoot
    }
end

local function cacheUnit(unit)
    if not unit or not unit.Parent then
        return
    end

    if not unit:IsA("Model") and not unit:IsA("BasePart") then
        return
    end

    local normalized = normalizeName(unit.Name)

    if not UnitCache[unit] then
        UnitCache[unit] = normalized
    end

    if not UnitCache[normalized] then
        UnitCache[normalized] = {}
    end

    UnitCache[normalized][unit] = true
end

local function uncacheUnit(unit)
    local normalized = UnitCache[unit]

    if type(normalized) ~= "string" then
        return
    end

    local list = UnitCache[normalized]

    if type(list) == "table" then
        list[unit] = nil
    end

    UnitCache[unit] = nil
end

local function getUnitsByName(name)
    local normalized = normalizeName(name)
    local list = UnitCache[normalized]

    if type(list) ~= "table" then
        return nil
    end

    return list
end

local function processUnit(unit)
    if not unit or not unit.Parent then
        return
    end

    if not unit:IsA("Model") and not unit:IsA("BasePart") then
        return
    end

    cacheUnit(unit)

    local normalized = normalizeName(unit.Name)

    if OrdealESPEnabled and OrdealLookup[normalized] then
        createESP(unit, unit.Name, "Ordeal", false)
        return
    end

    if not AbnormalityESPEnabled then
        return
    end

    if SpecialLookup[normalized] then
        createESP(unit, SpecialLookup[normalized], "Abnormality", true)
        return
    end

    if MinionLookup[normalized] then
        return
    end

    for _, abnormality in ipairs(Abnormalities:GetChildren()) do
        local breached = abnormality:FindFirstChild("IsBreached")

        if breached and breached:IsA("BoolValue") and breached.Value then
            if normalizeName(abnormality.Name) == normalized then
                createESP(unit, abnormality.Name, "Abnormality", true)
                return
            end
        end
    end
end

local function processMinionsForAbnormality(abnormality)
    if not AbnormalityESPEnabled then
        return
    end

    local breached = abnormality:FindFirstChild("IsBreached")

    if not breached or not breached:IsA("BoolValue") or not breached.Value then
        return
    end

    local minions = Minions[abnormality.Name]

    if not minions then
        return
    end

    for _, minionName in ipairs(minions) do
        local list = getUnitsByName(minionName)

        if list then
            for unit in pairs(list) do
                if unit and unit.Parent then
                    createESP(unit, unit.Name, "Minion", false)
                end
            end
        end
    end
end

local function processAbnormality(abnormality)
    if not abnormality or not abnormality.Parent then
        return
    end

    local breached = abnormality:FindFirstChild("IsBreached")

    if not breached or not breached:IsA("BoolValue") then
        return
    end

    if not breached.Value then
        for unit, data in pairs(ESPData) do
            if data.Abnormality == abnormality then
                removeESP(unit)
            end
        end

        return
    end

    if not AbnormalityESPEnabled then
        return
    end

    local list = getUnitsByName(abnormality.Name)

    if list then
        for unit in pairs(list) do
            if unit and unit.Parent then
                createESP(unit, abnormality.Name, "Abnormality", true)

                if ESPData[unit] then
                    ESPData[unit].Abnormality = abnormality
                end
            end
        end
    end

    processMinionsForAbnormality(abnormality)
end

local function fullRebuild()
    if Processing then
        RescanRequested = true
        return
    end

    Processing = true
    RescanRequested = false

    local ok = pcall(function()
        if not AbnormalityESPEnabled and not OrdealESPEnabled then
            for unit in pairs(ESPData) do
                removeESP(unit)
            end
            return
        end

        UnitCache = {}

        local children = Units:GetChildren()

        for i = 1, #children do
            local unit = children[i]

            if unit and unit.Parent then
                cacheUnit(unit)
            end

            if i % 40 == 0 then
                task.wait()
            end
        end

        for i = 1, #children do
            local unit = children[i]

            if unit and unit.Parent then
                processUnit(unit)
            end

            if i % 40 == 0 then
                task.wait()
            end
        end

        if AbnormalityESPEnabled then
            local abnormalities = Abnormalities:GetChildren()

            for i = 1, #abnormalities do
                processAbnormality(abnormalities[i])

                if i % 10 == 0 then
                    task.wait()
                end
            end
        end
    end)

    Processing = false

    if not ok then
        for unit in pairs(ESPData) do
            if not unit.Parent then
                removeESP(unit)
            end
        end
    end

    if RescanRequested then
        RescanRequested = false
        scheduleRebuild()
    end
end

function scheduleRebuild()
    if Scheduled then
        RescanRequested = true
        return
    end

    Scheduled = true

    task.delay(0.35, function()
        Scheduled = false

        if AbnormalityESPEnabled or OrdealESPEnabled then
            fullRebuild()
        end
    end)
end

local function onUnitAdded(unit)
    if not AbnormalityESPEnabled and not OrdealESPEnabled then
        return
    end

    task.defer(function()
        if unit and unit.Parent then
            cacheUnit(unit)
            processUnit(unit)

            if AbnormalityESPEnabled then
                for _, abnormality in ipairs(Abnormalities:GetChildren()) do
                    processAbnormality(abnormality)
                end
            end
        end
    end)
end

local function onUnitRemoved(unit)
    removeESP(unit)
    uncacheUnit(unit)
end

local function setupAbnormality(abnormality)
    if AbnormalityCache[abnormality] then
        return
    end

    AbnormalityCache[abnormality] = true

    local breached = abnormality:FindFirstChild("IsBreached")

    if breached and breached:IsA("BoolValue") then
        breached:GetPropertyChangedSignal("Value"):Connect(function()
            processAbnormality(abnormality)
        end)
    end

    abnormality.ChildAdded:Connect(function(child)
        if child.Name == "IsBreached" and child:IsA("BoolValue") then
            child:GetPropertyChangedSignal("Value"):Connect(function()
                processAbnormality(abnormality)
            end)

            processAbnormality(abnormality)
        end
    end)
end

for _, abnormality in ipairs(Abnormalities:GetChildren()) do
    setupAbnormality(abnormality)
end

Units.ChildAdded:Connect(onUnitAdded)
Units.ChildRemoved:Connect(onUnitRemoved)

Abnormalities.ChildAdded:Connect(function(abnormality)
    setupAbnormality(abnormality)

    if AbnormalityESPEnabled then
        scheduleRebuild()
    end
end)

Abnormalities.ChildRemoved:Connect(function(abnormality)
    AbnormalityCache[abnormality] = nil

    for unit, data in pairs(ESPData) do
        if data.Abnormality == abnormality then
            removeESP(unit)
        end
    end
end)

