local AutoWorkToggle = Tab:Toggle({
    Title = "Bật/Tắt Auto Work",
    Desc = "Làm tuần tự từng Abnormality đã chọn",
    Value = false,

    Callback = function(Value)
        AutoWorkEnabled = Value

        if not AutoWorkEnabled then
            WindUI:Notify({
                Title = "Auto Work",
                Content = "Đã tắt Auto Work.",
                Duration = 3
            })
            return
        end

        if #SelectedAbnormalities == 0 then
            AutoWorkEnabled = false

            WindUI:Notify({
                Title = "Cảnh Báo!",
                Content = "Bạn chưa chọn Abnormality!",
                Duration = 4
            })

            pcall(function()
                AutoWorkToggle:Set(false)
            end)

            return
        end

        if not SelectedWork then
            AutoWorkEnabled = false

            WindUI:Notify({
                Title = "Cảnh Báo!",
                Content = "Bạn chưa chọn Loại Công Việc!",
                Duration = 4
            })

            pcall(function()
                AutoWorkToggle:Set(false)
            end)

            return
        end

        local WaitTime = SpeedTimes[SelectedSpeed] or 5.5

        WindUI:Notify({
            Title = "Auto Work",
            Content = "Đã bật | " .. SelectedSpeed .. " | " .. WaitTime .. "s",
            Duration = 3
        })

        task.spawn(function()
            while AutoWorkEnabled do

                for Index, AbnormalityName in ipairs(SelectedAbnormalities) do

                    if not AutoWorkEnabled then
                        break
                    end

                    local targetAbnormality =
                        AbnormalitiesFolder:FindFirstChild(
                            AbnormalityName
                        )

                    if targetAbnormality then

                        local tablet =
                            targetAbnormality:FindFirstChild(
                                "WorkTablet"
                            )

                        local workTimeValue =
                            targetAbnormality:FindFirstChild(
                                "WorkTime"
                            )

                        if tablet and workTimeValue then

                            Event:FireServer(
                                tablet,
                                SelectedWork
                            )

                            task.wait(1.5)

                            if not AutoWorkEnabled then
                                break
                            end

                            local lastValue =
                                workTimeValue.Value

                            repeat
                                task.wait(1)

                                if not AutoWorkEnabled then
                                    break
                                end

                                local currentValue =
                                    workTimeValue.Value

                                if currentValue ~= lastValue then
                                    lastValue = currentValue
                                else
                                    break
                                end

                            until not AutoWorkEnabled
                                or workTimeValue.Value <= 0
                        end
                    end

                    if not AutoWorkEnabled then
                        break
                    end

                    if Index < #SelectedAbnormalities then
                        task.wait(
                            SpeedTimes[SelectedSpeed] or 5.5
                        )
                    end
                end

                task.wait(0.5)
            end
        end)
    end
})

