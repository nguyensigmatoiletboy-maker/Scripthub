local function normalizeName(name)
    local cached = UnitCache[name]

    if cached then
        return cached
    end

    local result = string.lower(name)
    result = result:gsub("%s*%b()$", "")
    result = result:gsub("%s+$", "")

    UnitCache[name] = result

    return result
end

local MinionLookup = {}
local OrdealLookup = {}
local SpecialLookup = {}

for root, list in pairs(Minions) do
    for _, name in ipairs(list) do
        MinionLookup[normalizeName(name)] = true
    end
end

for name in pairs(OrdealUnits) do
    OrdealLookup[normalizeName(name)] = true
end

for name in pairs(SpecialUnits) do
    SpecialLookup[normalizeName(name)] = name
end

local function removeESP(unit)
    local data = ESPData[unit]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    ESPData[unit] = nil
end

local function createESP(unit, name, espType, isRoot)
    if not unit or not unit.Parent then
        return
    end

    local old = ESPData[unit]

    if old and old.Type == espType and old.Name == name and old.Root == isRoot then
        return
    end

    if old then
        removeESP(unit)
    end

    local fillColor
    local outlineColor
    local textColor
    local backgroundColor

    if espType == "Abnormality" then
        fillColor = Color3.fromRGB(255, 55, 75)
        outlineColor = Color3.fromRGB(255, 150, 160)
        textColor = Color3.fromRGB(255, 100, 115)
        backgroundColor = Color3.fromRGB(20, 8, 12)
    elseif espType == "Minion" then
        fillColor = Color3.fromRGB(65, 155, 255)
        outlineColor = Color3.fromRGB(150, 215, 255)
        textColor = Color3.fromRGB(105, 195, 255)
        backgroundColor = Color3.fromRGB(7, 14, 24)
    else
        fillColor = Color3.fromRGB(175, 80, 255)
        outlineColor = Color3.fromRGB(220, 170, 255)
        textColor = Color3.fromRGB(210, 145, 255)
        backgroundColor = Color3.fromRGB(18, 8, 28)
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = unit
    highlight.FillColor = fillColor
    highlight.OutlineColor = outlineColor
    highlight.FillTransparency = espType == "Ordeal" and 0.72 or 0.65
    highlight.OutlineTransparency = 0.05
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = unit

    local billboard = Instance.new("BillboardGui")
