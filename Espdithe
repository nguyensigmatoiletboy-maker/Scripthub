local Lighting = game:GetService("Lighting")

local AntiDark = false
local FullBright = false
local BrightnessValue = 5

local SavedLighting = nil
local SavedEffects = {}

local function SaveLighting()
    SavedLighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        GlobalShadows = Lighting.GlobalShadows,
        ExposureCompensation = Lighting.ExposureCompensation,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        ColorShift_Top = Lighting.ColorShift_Top,
        ColorShift_Bottom = Lighting.ColorShift_Bottom,
    }

    SavedEffects = {}

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere")
        or obj:IsA("BloomEffect")
        or obj:IsA("ColorCorrectionEffect")
        or obj:IsA("SunRaysEffect")
        or obj:IsA("DepthOfFieldEffect") then
            SavedEffects[obj] = obj.Enabled
        end
    end
end

local function RestoreLighting()
    if not SavedLighting then
        return
    end

    Lighting.Brightness = SavedLighting.Brightness
    Lighting.ClockTime = SavedLighting.ClockTime
    Lighting.GlobalShadows = SavedLighting.GlobalShadows
    Lighting.ExposureCompensation = SavedLighting.ExposureCompensation
    Lighting.Ambient = SavedLighting.Ambient
    Lighting.OutdoorAmbient = SavedLighting.OutdoorAmbient
    Lighting.ColorShift_Top = SavedLighting.ColorShift_Top
    Lighting.ColorShift_Bottom = SavedLighting.ColorShift_Bottom

    for obj, enabled in pairs(SavedEffects) do
        if obj and obj.Parent then
            obj.Enabled = enabled
        end
    end

    SavedLighting = nil
    SavedEffects = {}
end

local function ApplyLighting()
    if not AntiDark and not FullBright then
        return
    end

    if AntiDark then
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)

        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere")
            or obj:IsA("BloomEffect")
            or obj:IsA("ColorCorrectionEffect")
            or obj:IsA("SunRaysEffect")
            or obj:IsA("DepthOfFieldEffect") then
                obj.Enabled = false
            end
        end
    end

    if FullBright then
        Lighting.Brightness = BrightnessValue
        Lighting.ExposureCompensation = BrightnessValue / 2
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
    end
end

local function UpdateState()
    if AntiDark or FullBright then
        if not SavedLighting then
            SaveLighting()
        end

        ApplyLighting()
    else
        RestoreLighting()
    end
end

